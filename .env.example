# ==========================================
# SECUREMIND AI - Environment Configuration
# ==========================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
POSTGRES_DB=securemind_db
POSTGRES_USER=securemind_user
POSTGRES_PASSWORD=securemind_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cache & Task Broker (Redis)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_ALLOW_DEMO_AUTO_LOGIN=false

# Scanner Engine Configuration
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=securemind-zap-api-key
NUCLEI_TEMPLATES_DIR=/app/nuclei-templates

# SSRF & Target Scope Protection
# Set to True only for internal enterprise/self-hosted scanning of private networks
ALLOW_PRIVATE_IP_SCANS=False

# AI Model Provider Configuration
# Supported providers: gemini, openai, anthropic, or local-ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_REASONING_MODEL=gemini-2.5-pro
AI_REQUEST_TIMEOUT_SECONDS=60
